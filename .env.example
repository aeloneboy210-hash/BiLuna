# Both values are safe to expose to the browser. Access is enforced by database rules, not by hiding these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never commit a value.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: the Gemini model id (default gemini-2.5-flash-lite).
BILUNA_AI_MODEL=
